{
  "name": "warroom-demo-shop",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "dev": {
    "port": 8798
  },
  // Synthetic customers every minute, so problems show up even when real traffic is low.
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Plain vars. WARROOM_INGEST_TOKEN is a secret (`npx wrangler secret put WARROOM_INGEST_TOKEN`; locally in .dev.vars).
  "vars": {
    "SERVICE_NAME": "brewline-shop",
    "GITHUB_REPO": "TeodorRidder/warroom-demo-shop",
    "WARROOM_URL": "https://warroom.hlt-coshell.workers.dev",
    // Scheduled synthetic customers are off; run journeys from the ops console instead.
    "TRAFFIC_PER_MINUTE": "0",
    // "ops": only crashes from the ops console open War Room incidents. "all": every crash does.
    "REPORT_CRASHES": "ops"
  },
  "durable_objects": {
    "bindings": [{ "name": "TRACKER", "class_name": "ErrorTracker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ErrorTracker"] }]
}
